# Stardust.ai Chatbot Configuration Example
# Copy this file to .streamlit/secrets.toml and fill in your API keys

# OpenAI Configuration
openai-key = "your-openai-api-key-here"

# Debug and Development Settings
debug = false
streaming = true

# Optional API Keys (uncomment and fill if needed)
# bing-cookie = "your-bing-cookie-here"
# google-api-key = "your-google-api-key-here"

# Database Configuration (optional)
# database-url = "sqlite:///data/chatbot.db"

# Analytics Configuration (optional)
# analytics-enabled = true
# sentry-dsn = "your-sentry-dsn-here"
